[Unit]
Description=Update the MaxMind GeoLite2 databases (geoipupdate) and reload the WAF
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
# GEOIPUPDATE_ACCOUNT_ID / GEOIPUPDATE_LICENSE_KEY are written by the operator in $WAF_CONFIG_DIR/secrets.env.
EnvironmentFile=/etc/default/wafctl
ExecStart=/usr/bin/docker run --rm --env-file ${WAF_CONFIG_DIR}/secrets.env -e "GEOIPUPDATE_EDITION_IDS=GeoLite2-Country GeoLite2-ASN" -v ${WAF_DATA_DIR}/geoip:/usr/share/GeoIP maxmindinc/geoipupdate:v8.0.0
ExecStart=/usr/local/bin/wafctl apply
