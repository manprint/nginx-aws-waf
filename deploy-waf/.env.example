# Copia in .env:  cp .env.example .env
# Le righe commentate mostrano il valore di default. Dopo una modifica: docker compose up -d

# ========== OBBLIGATORIE ==========

# Domini serviti, separati da virgola (minuscolo; ammesso *.dominio.it)
WAF_SERVER_NAMES=app.interno.local

# ========== DOVE MANDARE IL TRAFFICO PULITO ==========

# Servizio nginx dietro il WAF, "nome-servizio:porta"
# WAF_UPSTREAM=nginx:443
# true = il WAF parla HTTPS con nginx (porta 443); false = HTTP (porta 80)
# WAF_UPSTREAM_TLS=true

# ========== HTTPS ==========

# off      = solo HTTP
# on       = HTTP e HTTPS, nessun redirect
# redirect = HTTP → 301 → HTTPS (consigliato)
# Con on/redirect servono certs/<WAF_SITE_ID>/fullchain.pem e privkey.pem
# WAF_TLS_MODE=redirect

# ========== COMPORTAMENTO DEL WAF ==========

# aws-default = regole AWS "one-click" (IpReputation + CommonRuleSet + KnownBadInputs), blocca
# shadow      = come aws-default ma NON blocca, registra solo (consigliato i primi giorni)
# strict      = aws-default + SQL injection + IP anonimi (Tor)
# odoo-12 | odoo-14 | odoo-16 | odoo-18 = aws-default con le eccezioni per Odoo
# WAF_PROFILE=aws-default

# Forza la modalità: enforce (blocca) | count (registra soltanto). Vuoto = quella del profilo
# WAF_MODE=

# Cosa succede a un Host non presente in WAF_SERVER_NAMES:
#   app = va comunque a nginx (passando dal WAF)    vuoto = connessione chiusa (444)
# WAF_DEFAULT_SITE=app

# Byte di body ispezionati: 8192 (come AWS) ... 1048576
# WAF_BODY_LIMIT=8192

# Rate limit per IP: numero di richieste nella finestra (>= 10). Vuoto = disattivato
# WAF_RATE_LIMIT=
# WAF_RATE_WINDOW_SEC=300          # 60 | 120 | 300 | 600
# WAF_RATE_ACTION=block            # block | count

# Blocco per paese (ISO, es. CN,RU): richiede WAF_GEOIP=true e geoip/GeoLite2-Country.mmdb
# WAF_GEOIP=false
# WAF_GEO_BLOCK=
# WAF_GEO_ACTION=block

# C'è un proxy/load balancer DAVANTI al WAF? Metti il suo CIDR: l'IP del client
# verrà preso da X-Forwarded-For. Vuoto = l'IP del client è quello della connessione.
# WAF_TRUSTED_PROXIES=

# Upload massimo (client_max_body_size) e timeout verso nginx
# WAF_MAX_BODY_SIZE=10m
# WAF_READ_TIMEOUT_SEC=60

# ========== PORTE SULL'HOST ==========

# BIND_ADDRESS=0.0.0.0             # es. 10.0.0.5 per una sola interfaccia
# HTTP_PORT=80
# HTTPS_PORT=443
# METRICS_BIND_ADDRESS=0.0.0.0     # 127.0.0.1 se Prometheus gira sulla stessa macchina
# METRICS_PORT=9598

# ========== MANUTENZIONE ==========

# WAF_NODE_ID=waf                  # nome del nodo nei log e nelle metriche
# WAF_SITE_ID=app                  # nome del sito (= cartella dei certificati certs/<id>/)
# WAF_WATCH_INTERVAL=30            # secondi: rilegge config/ e ricarica se cambiata (0 = off)
# WAF_LOG_MAX_SIZE_MB=512          # ruota un log oltre questa dimensione
# WAF_LOG_KEEP_HOURS=24            # tiene i log ruotati per queste ore
# WAF_RAW_DAYS=7                   # giorni di eventi JSONL conservati
# WAF_LISTS_UPDATE=false           # true = aggiorna le liste IP ogni giorno (serve internet)
# WAF_LISTS_UPDATE_HOURS=24
# WAF_AUDIT_SCOPE=all              # all | relevant (audit log solo per richieste con match)
# WAF_WORKERS=0                    # processi nginx, 0 = uno per CPU
# WAF_IMAGE=nginx-aws-waf/aio:latest
