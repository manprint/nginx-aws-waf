# site {{.ID}} — generated by wafctl, DO NOT EDIT
upstream up_{{.ID}} { zone up_{{.ID}} 64k;{{range .Servers}} server {{.}}{{if $.Bridge}} resolve{{end}};{{end}} keepalive 32; }
{{- if .RT}}
upstream up_{{.ID}}_rt { zone up_{{.ID}}_rt 64k;{{range .RT.Servers}} server {{.}}{{if $.Bridge}} resolve{{end}};{{end}} }
{{- end}}
{{- if .Redirect}}
server {
{{- range .HTTPListens}}
  {{.}}
{{- end}}
  server_name {{.Names}};
  set $waf_site {{.ID}}; set $waf_app {{.App}};
  modsecurity off;
  return 301 https://$host$request_uri;
}
{{- end}}
server {
{{- range .Listens}}
  {{.}}
{{- end}}
{{- if .TLS}}
  http2 on;
  ssl_certificate /etc/waf/certs/{{.ID}}/{{.Cert}}; ssl_certificate_key /etc/waf/certs/{{.ID}}/{{.Key}};
  ssl_protocols TLSv1.2 TLSv1.3; ssl_session_cache shared:SSL:20m; ssl_session_timeout 1h;
{{- end}}
  server_name {{.Names}};
  set $waf_site {{.ID}}; set $waf_app {{.App}};
  modsecurity_rules_file {{.R}}/modsec/sites/{{.ID}}.conf;
  client_max_body_size {{.MaxBody}};
{{- if .RealIP}}
{{- range .RealIP}}
  set_real_ip_from {{.}};
{{- end}}
  real_ip_header X-Forwarded-For; real_ip_recursive on;
{{- end}}
{{- if .Rate}}
  limit_req zone=rl_{{.ID}} burst={{.Rate.Limit}} nodelay; limit_req_status 403;
{{- if eq .Rate.Action "count"}}
  limit_req_dry_run on;
{{- end}}
{{- end}}
  error_page 403 /__waf/403.html; error_page 500 /__waf/500.html;
  location ^~ /__waf/ { internal; modsecurity off; alias {{.R}}/static/{{.ID}}/; default_type text/html; more_set_headers "Server: awselb/2.0"; }
{{- if .RT}}
  location {{.RT.Path}} {
    proxy_pass http://up_{{.ID}}_rt;
{{- template "proxy" (dict "S" . "RT" true)}}
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
  }
{{- end}}
  location / {
    proxy_pass {{.Scheme}}://up_{{.ID}};
{{- template "proxy" (dict "S" . "RT" false)}}
  }
}
{{- define "proxy"}}
    proxy_http_version 1.1;
{{- if not .RT}}
    proxy_set_header Connection "";
{{- end}}
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_connect_timeout 5s;
    proxy_send_timeout {{.S.ReadTimeout}}s;
{{- if not .RT}}
    proxy_read_timeout {{.S.ReadTimeout}}s;
{{- end}}
{{- end}}
