    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(increase(waf_requests_total{site=~\"$site\",action=\"ALLOW\",shadow_action=\"BLOCK\"}[$__range])) or vector(0)",
