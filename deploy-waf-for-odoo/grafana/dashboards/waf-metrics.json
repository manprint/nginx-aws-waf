     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (action) (rate(waf_requests_total{site=~\"$site\"}[$__rate_interval]))",
     "legendFormat": "{{action}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "ALLOW"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "BLOCK"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "FAIL"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "purple"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
