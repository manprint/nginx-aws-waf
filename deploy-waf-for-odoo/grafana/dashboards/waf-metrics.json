  {
   "type": "table",
   "title": "Match per regola (periodo) — anche le regole in count",
   "id": 15,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 9,
    "w": 14,
    "x": 10,
    "y": 30
   },
   "description": "configured_action = azione della regola (BLOCK/COUNT); request_action = cosa è successo alla richiesta. Una regola COUNT con molti match su traffico legittimo è un falso positivo da gestire prima di bloccare.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (site, rule_group, rule, configured_action, request_action) (increase(waf_rule_matches_total{site=~\"$site\"}[$__range])) > 0",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value": "match",
       "rule_group": "gruppo",
       "rule": "regola",
       "configured_action": "azione regola",
       "request_action": "esito richiesta"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "sortBy": [
     {
      "displayName": "match",
      "desc": true
     }
    ],
    "showHeader": true
   }
  },
