     "editorType": "sql",
     "queryType": "table",
     "format": 1,
     "rawSql": "SELECT rule_name AS Regola, path AS Percorso, waf_dove(variable) AS Dove, configured_action AS Azione, count() AS Match, uniq(client_ip) AS IP, any(substring(value, 1, 100)) AS `Esempio valore` FROM waf.matches WHERE $__timeFilter(ts) AND ('__all__' IN (${site:singlequote}) OR site_id IN (${site:singlequote})) AND ('__all__' IN (${regola:singlequote}) OR rule_name IN (${regola:singlequote})) GROUP BY Regola, Percorso, Dove, Azione ORDER BY Match DESC LIMIT 50",
