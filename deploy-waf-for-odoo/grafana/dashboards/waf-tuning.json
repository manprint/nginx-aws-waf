   "title": "Capacità usata (WCU) per sito",
   "description": "Web ACL Capacity Units: somma dei WCU dei gruppi gestiti (valori AWS) + stima delle regole custom e del rate limit. Il limite base AWS è 1500 WCU per Web ACL (oltre si paga, max 5000).",
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "ch"
     },
     "editorType": "sql",
     "queryType": "table",
     "format": 1,
     "rawSql": "SELECT site_id AS Sito, sum(wcu) AS WCU FROM waf.site_rules_current WHERE kind IN ('group', 'custom', 'setting') AND ('__all__' IN (${site:singlequote}) OR site_id IN (${site:singlequote})) GROUP BY site_id ORDER BY site_id",
     "refId": "A"
