  {
   "type": "table",
   "title": "Regole attive per sito, con match nel periodo",
   "description": "Ogni regola come in AWS: azione di default, azione effettiva (dopo profili e override), origine dell'override, fedeltà rispetto ad AWS. A destra i match nel periodo: una regola in COUNT con molti match è un candidato da valutare; una regola che non matcha mai non costa nulla.",
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "ch"
     },
     "editorType": "sql",
     "queryType": "table",
     "format": 1,
     "rawSql": "SELECT r.site_id AS Sito, r.kind AS Tipo, replaceRegexpOne(r.rule_group, '^AWSManagedRules', '') AS Gruppo, r.rule_name AS Regola, r.default_action AS Default, r.effective_action AS Effettiva, if(r.effective_action != r.default_action AND r.kind = 'managed', '✎ override', '') AS Override, r.origin AS Origine, r.fidelity AS `Fedeltà`, if(r.wcu = 0, NULL, r.wcu) AS WCU, m.matches AS Match, m.blocked AS Bloccate, m.counted AS `In count`, if(m.matches = 0, NULL, m.last) AS `Ultimo match` FROM waf.site_rules_current r LEFT JOIN (SELECT site_id, rule_name, count() AS matches, countIf(request_action = 'BLOCK' AND configured_action = 'BLOCK' AND post_terminating = 0) AS blocked, countIf(configured_action = 'COUNT') AS counted, max(ts) AS last FROM waf.matches WHERE $__timeFilter(ts) GROUP BY site_id, rule_name) m ON m.site_id = r.site_id AND m.rule_name = r.rule_name WHERE r.kind IN ('group', 'managed', 'custom') AND ('__all__' IN (${site:singlequote}) OR r.site_id IN (${site:singlequote})) ORDER BY r.site_id, r.position",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true,
      "inspect": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Default"
      },
      "properties": [
