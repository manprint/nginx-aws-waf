        "value": [
         {
          "type": "value",
          "options": {
           "BLOCK": {
            "color": "red",
            "index": 0
           },
           "COUNT": {
            "color": "yellow",
            "index": 1
           },
           "ALLOW": {
            "color": "green",
            "index": 2
           },
           "ENABLED": {
