  {
   "type": "timeseries",
   "title": "Andamento di $regola per esito (come le metriche CloudWatch per regola)",
   "description": "bloccate = la regola ha deciso il blocco; in count = ha trovato qualcosa ma è in count; senza effetto = ha matchato dopo che un'altra regola aveva già deciso, o era fuori scope.",
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "ch"
     },
     "editorType": "sql",
     "queryType": "timeseries",
     "format": 0,
     "rawSql": "SELECT $__timeInterval(ts) AS time, countIf(configured_action = 'BLOCK' AND request_action = 'BLOCK' AND post_terminating = 0) AS bloccate, countIf(configured_action = 'COUNT') AS `in count`, countIf(NOT (configured_action = 'BLOCK' AND request_action = 'BLOCK' AND post_terminating = 0) AND configured_action != 'COUNT') AS `senza effetto` FROM waf.matches WHERE $__timeFilter(ts) AND ('__all__' IN (${site:singlequote}) OR site_id IN (${site:singlequote})) AND ('__all__' IN (${regola:singlequote}) OR rule_name IN (${regola:singlequote})) GROUP BY time ORDER BY time",
     "refId": "A"
    }
   ],
