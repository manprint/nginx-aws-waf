{
 "uid": "waf-nodes",
 "title": "WAF Nodes Health",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "tags": [
  "waf"
 ],
 "timezone": "utc",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "table",
   "title": "Heartbeat dei nodi",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "ch"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "ch"
     },
     "editorType": "sql",
     "queryType": "table",
     "format": 1,
     "rawSql": "SELECT node_id, argMax(version, ts) AS version, argMax(config_rev, ts) AS config_rev, max(ts) AS last_seen, dateDiff('second', max(ts), now64(3)) AS age_s FROM waf.heartbeats GROUP BY node_id ORDER BY node_id",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Richieste/s nginx",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (node_id) (rate(nginx_http_requests_total[1m]))",
     "refId": "A",
     "legendFormat": "{{node_id}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "fillOpacity": 10,
      "drawStyle": "line"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Connessioni attive nginx",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (node_id) (nginx_connections_active)",
     "refId": "A",
     "legendFormat": "{{node_id}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "fillOpacity": 10,
      "drawStyle": "line"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "CPU occupata",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "100 * (1 - avg by (node_id) (rate(host_cpu_seconds_total{mode=\"idle\"}[1m])))",
     "refId": "A",
     "legendFormat": "{{node_id}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "fillOpacity": 10,
      "drawStyle": "line"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Memoria disponibile",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "host_memory_available_bytes",
     "refId": "A",
     "legendFormat": "{{node_id}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "fillOpacity": 10,
      "drawStyle": "line"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Buffer Vector",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (node_id) (vector_buffer_size_bytes)",
     "refId": "A",
     "legendFormat": "{{node_id}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "fillOpacity": 10,
      "drawStyle": "line"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Errori componenti Vector",
   "gridPos": {
    "x": 8,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (node_id, component_id) (rate(vector_component_errors_total[5m]))",
     "refId": "A",
     "legendFormat": "{{node_id}} {{component_id}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "fillOpacity": 10,
      "drawStyle": "line"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Query ClickHouse in corso",
   "gridPos": {
    "x": 16,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "ClickHouseMetrics_Query{job=\"clickhouse\"}",
     "refId": "A",
     "legendFormat": "clickhouse"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "fillOpacity": 10,
      "drawStyle": "line"
     }
    },
    "overrides": []
   },
   "options": {}
  }
 ],
 "links": [
  {
   "type": "dashboards",
   "tags": [
