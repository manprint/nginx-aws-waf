# Facoltativo: cp .env.example .env  (senza .env valgono i default qui sotto)

# Porta HTTP sull'host
# HTTP_PORT=80
# Porta di Grafana (accesso diretto, senza WAF)
# GRAFANA_PORT=3000
# Porte di ClickHouse (HTTP e nativa)
# CH_HTTP_PORT=8123
# CH_TCP_PORT=9000

# Moduli Odoo installati alla creazione del database e dati demo
# ODOO_MODULES=contacts,sale_management,crm
# ODOO_DEMO=true

# Password ClickHouse (valgono solo alla PRIMA creazione di data/clickhouse)
# WAF_CH_ADMIN_PASSWORD=waf_admin
# WAF_CH_INGEST_PASSWORD=waf_ingest
# WAF_CH_RO_PASSWORD=waf_ro

# Immagine del WAF pubblicata su ghcr.io (tag: latest, vX.Y.Z, sha8). Se il pull fallisce viene
# costruita da ../deploy-waf/Dockerfile; per forzare la build locale: docker compose up -d --build
# WAF_IMAGE=ghcr.io/manprint/nginx-aws-waf/aio:latest

# GeoIP: regole geo/geo_block nel WAF (servono data/geoip/*.mmdb, vedi README "GeoIP")
# WAF_GEOIP=false
# Solo per "docker compose run --rm geoip-maxmind" (account gratuito maxmind.com)
# GEOIPUPDATE_ACCOUNT_ID=
# GEOIPUPDATE_LICENSE_KEY=
